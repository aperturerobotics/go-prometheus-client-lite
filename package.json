{
  "name": "@aperturerobotics/go-prometheus-client-lite",
  "description": "Lightweight Prometheus Go client fork for Aperture Robotics.",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "deps": "depcheck --ignore-patterns=package.json --ignores depcheck,prettier,rimraf,typescript,@go/github.com,@aptre/protobuf-es-lite",
    "codegen": "bun run gen",
    "gen": "bun run go:aptre -- generate --targets ./client_model/go/*.proto --features equal",
    "gen:force": "bun run go:aptre -- generate --force --targets ./client_model/go/*.proto --features equal",
    "format": "bun run format:go && bun run format:config",
    "format:go": "bun run go:aptre -- format",
    "format:config": "prettier --write package.json",
    "test": "bun run test:go",
    "test:go": "bun run go:aptre -- test",
    "lint": "bun run lint:go",
    "lint:go": "bun run go:aptre -- lint",
    "fix": "bun run fix:go && bun run format",
    "fix:go": "bun run go:aptre -- fix",
    "ci": "bun run lint:go && bun run test:go",
    "prepare": "go mod vendor && rimraf ./.tools",
    "go:aptre": "go run -mod=mod github.com/aperturerobotics/common/cmd/aptre",
    "precommit": "bun run format"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "devDependencies": {
    "depcheck": "^1.4.7",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@aptre/protobuf-es-lite": "^1.0.2"
  },
  "resolutions": {
    "@aptre/protobuf-es-lite": "^1.0.2"
  }
}
